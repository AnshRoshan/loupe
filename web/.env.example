# Required: PostgreSQL. For Supabase/Vercel, use the transaction pooler connection.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres
# Set to the deployed site URL, without a trailing slash.
APP_URL=http://localhost:3000

# Optional managed authentication: configure BOTH URL and public key.
# Without these, standalone email/password authentication uses PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key supported as an alternative:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional web AI review. Static checks need no AI key.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# GitHub tokens are supplied per scan, never saved or shared server-wide.
# The original GitHub Action is configured independently through GitHub secrets.
